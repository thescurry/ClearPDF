<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClearPDF.Desktop.Views.PasswordWindow"
        Title="Password"
        Width="360" Height="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="This PDF is password protected."
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Cancel_Click" Width="88"/>
            <Button Content="Unlock" Click="Unlock_Click" Width="88"
                    Background="{DynamicResource AccentBrush}" Foreground="White"/>
        </StackPanel>
        <TextBox x:Name="PasswordBox" PasswordChar="•"
                 Watermark="Password" />
    </DockPanel>
</Window>
