<Window x:Class="ClearPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClearPDF"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="720"
        FontFamily="Segoe UI"
        Background="{StaticResource CanvasBrush}"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
    <!-- Menu bar: About → Duck waffles easter egg -->
        <Menu DockPanel.Dock="Top"
              Background="{StaticResource ToolbarBrush}"
              BorderBrush="{StaticResource BorderMutedBrush}"
              BorderThickness="0,0,0,1"
              Padding="4,2">
            <MenuItem Header="_About">
                <MenuItem Header="Duck waffles" Click="DuckWaffles_Click"/>
            </MenuItem>
        </Menu>

        <!-- Thin icon-first toolbar (v1.1 polish) — labels live on hover ToolTips -->
        <Border x:Name="ToolbarBorder" DockPanel.Dock="Top"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderMutedBrush}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="6,1">
                <Button Style="{StaticResource ToolbarButton}" Click="Open_Click" ToolTip="Open (Ctrl+O)">
                    <TextBlock Text="📂" FontSize="15" HorizontalAlignment="Center"/>
                </Button>
                <Button x:Name="SaveAsButton" Style="{StaticResource ToolbarButton}" Click="SaveAs_Click" ToolTip="Save As">
                    <TextBlock Text="💾" FontSize="15" HorizontalAlignment="Center"/>
                </Button>
                <Button x:Name="PrintButton" Style="{StaticResource ToolbarButton}" Click="Print_Click" ToolTip="Print (Ctrl+P)">
                    <TextBlock Text="🖨" FontSize="15" HorizontalAlignment="Center"/>
                </Button>

                <Border Width="1" Background="#DDDDDD" Margin="6,5"/>

                <Button x:Name="ZoomOutButton" Style="{StaticResource ToolbarButton}" Click="ZoomOut_Click" ToolTip="Zoom out">
                    <TextBlock Text="🔍−" FontSize="15" HorizontalAlignment="Center"/>
                </Button>
                <Button x:Name="ZoomLabel" Content="100%"
                        Style="{StaticResource ToolbarButton}"
                        Click="ZoomReset_Click"
                        ToolTip="Reset to 100%"
                        VerticalAlignment="Center"
                        Margin="2,0" FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        MinWidth="40" Padding="6,3"/>
                <Button x:Name="ZoomInButton" Style="{StaticResource ToolbarButton}" Click="ZoomIn_Click" ToolTip="Zoom in">
                    <TextBlock Text="🔍+" FontSize="15" HorizontalAlignment="Center"/>
                </Button>

                <Border Width="1" Background="#DDDDDD" Margin="6,5"/>

                <Button x:Name="FitWidthButton" Style="{StaticResource ToolbarButton}" Click="FitWidth_Click" ToolTip="Fit width">
                    <TextBlock Text="↔" FontSize="15" HorizontalAlignment="Center"/>
                </Button>
                <Button x:Name="FitPageButton" Style="{StaticResource ToolbarButton}" Click="FitPage_Click" ToolTip="Fit page">
                    <TextBlock Text="⛶" FontSize="15" HorizontalAlignment="Center"/>
                </Button>
                <Button x:Name="FindButton" Style="{StaticResource ToolbarButton}" Click="FindToggle_Click" ToolTip="Find (Ctrl+F)">
                    <TextBlock Text="🔎" FontSize="15" HorizontalAlignment="Center"/>
                </Button>

                <!-- Inline find strip -->
                <StackPanel x:Name="FindPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <TextBox x:Name="FindBox" Width="148" Height="24" VerticalContentAlignment="Center"
                             Padding="6,1" KeyDown="FindBox_KeyDown"/>
                    <Button Content="Prev" Style="{StaticResource ToolbarButton}" Click="FindPrev_Click" Margin="4,0,0,0"
                            ToolTip="Previous match"/>
                    <Button Content="Next" Style="{StaticResource ToolbarButton}" Click="FindNext_Click"
                            ToolTip="Next match"/>
                    <TextBlock x:Name="FindStatus" VerticalAlignment="Center" Margin="8,0,0,0"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status bar (mock 02) -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom"
                Background="{StaticResource StatusBarBrush}"
                BorderBrush="{StaticResource BorderMutedBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,3"
                Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="PageStatusText" Text="1 / 1"
                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="ZoomStatusText" Text="100%"
                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Background="#FDECEA"
                BorderBrush="#F5C2C0" BorderThickness="0,0,0,1" Padding="12,8"
                Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource ToolbarButton}"
                        Click="DismissError_Click"/>
                <TextBlock x:Name="ErrorBannerText" TextWrapping="Wrap"
                           Foreground="#8A1F11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Content host fills remaining DockPanel space (EmptyView must NOT Dock=Left). -->
        <Grid>
        <!-- Empty / recent (mock 01) -->
        <Grid x:Name="EmptyView" Background="{StaticResource CanvasBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                <!-- Simple dog-ear document icon -->
                <Viewbox Width="48" Height="54" Margin="0,0,0,10" HorizontalAlignment="Center">
                    <Canvas Width="48" Height="56">
                        <Path Stroke="#555555" StrokeThickness="2" Fill="Transparent"
                              Data="M8,4 L32,4 L40,12 L40,52 L8,52 Z"/>
                        <Path Stroke="#555555" StrokeThickness="2" Fill="Transparent"
                              Data="M32,4 L32,12 L40,12"/>
                        <Line X1="14" Y1="22" X2="34" Y2="22" Stroke="#555555" StrokeThickness="2"/>
                        <Line X1="14" Y1="30" X2="34" Y2="30" Stroke="#555555" StrokeThickness="2"/>
                        <Line X1="14" Y1="38" X2="28" Y2="38" Stroke="#555555" StrokeThickness="2"/>
                    </Canvas>
                </Viewbox>

                <TextBlock Text="Open a PDF"
                           FontSize="20" FontWeight="Normal"
                           Foreground="#333333"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <Button Content="Open..." Style="{StaticResource OpenHeroButton}"
                        HorizontalAlignment="Center" Click="Open_Click" Margin="0,0,0,18"/>

                <TextBlock Text="Recent"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,0,0,6"/>

                <ItemsControl x:Name="RecentList"
                              HorizontalAlignment="Center"
                              Width="320">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding DisplayName}"
                                        Style="{StaticResource RecentLink}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Tag="{Binding Path}"
                                        Click="RecentItem_Click"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RelativeTime}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="NoRecentText" Text="No recent files"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" Visibility="Collapsed"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Reader (mock 02): left thumbnails + page hero -->
        <Grid x:Name="ReaderView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource RailBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pages"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="12,8,12,4"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ThumbnailList" Margin="4,0,4,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="PageScroller" Grid.Column="1"
                          Background="{StaticResource CanvasBrush}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20"
                          ScrollChanged="PageScroller_ScrollChanged">
                <StackPanel x:Name="PageHost" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
