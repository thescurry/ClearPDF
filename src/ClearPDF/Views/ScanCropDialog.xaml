<Window x:Class="ClearPDF.Views.ScanCropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop page"
        Height="560" Width="520"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource CanvasBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderMutedBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" IsCancel="True"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Reset" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="Reset_Click"/>
                    <Button Content="Crop" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="Apply_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Margin="16,12,16,0"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Drag on the page to choose what to keep."/>
        <Border Margin="16" Background="White" BorderBrush="{StaticResource BorderMutedBrush}"
                BorderThickness="1">
            <Grid x:Name="Stage"
                  Background="{StaticResource CanvasBrush}"
                  ClipToBounds="True"
                  MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                  MouseMove="Stage_MouseMove"
                  MouseLeftButtonUp="Stage_MouseLeftButtonUp">
                <Image x:Name="PageImage" Stretch="Uniform" Margin="16"/>
                <Canvas x:Name="Overlay" IsHitTestVisible="False">
                    <Rectangle x:Name="CropRect"
                               Stroke="{StaticResource AccentBrush}"
                               StrokeThickness="2"
                               StrokeDashArray="4 2"
                               Fill="#335A7FA6"
                               Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </Border>
    </DockPanel>
</Window>
