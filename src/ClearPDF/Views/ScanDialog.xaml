<Window x:Class="ClearPDF.Views.ScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan to PDF"
        Height="620" Width="880"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource CanvasBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderMutedBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="InsertButton" Content="Add to open PDF"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="Insert_Click"
                            ToolTip="Insert scanned pages into the open file (Ctrl+I)"/>
                    <Button x:Name="SaveNewButton" Content="Save as new PDF"
                            Style="{StaticResource PrimaryButton}"
                            Click="SaveNew_Click"
                            ToolTip="Save a new PDF (Ctrl+S)"/>
                </StackPanel>
                <TextBlock x:Name="ShortcutHint"
                           Text="Space scan  ·  R rotate  ·  Del delete  ·  Ctrl+↑↓ move  ·  Esc stop"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Scanner" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ScannerBox" Height="30"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="ScannerBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                    Margin="16,0,0,0">
                            <Button x:Name="ScanButton" Content="Scan"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="28,8" FontSize="15"
                                    Click="Scan_Click"
                                    ToolTip="Scan (Space)"/>
                            <Button x:Name="ScanMoreButton" Content="Add more pages"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="Scan_Click"
                                    ToolTip="Scan another page (Space)"/>
                            <Button x:Name="CancelScanButton" Content="Stop"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="CancelScan_Click"
                                    IsEnabled="False"
                                    ToolTip="Cancel this scan (Esc)"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Source" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="SourceBox" Width="140" Height="28"
                                      SelectionChanged="SourceBox_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Color" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ColorBox" Width="140" Height="28"
                                      SelectionChanged="ColorBox_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                            <TextBlock Text="DPI" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="DpiBox" Width="80" Height="28"
                                      SelectionChanged="DpiBox_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                            <CheckBox x:Name="DuplexBox" Content="Both sides (duplex)"
                                      VerticalAlignment="Center"
                                      Checked="DuplexBox_Changed" Unchecked="DuplexBox_Changed"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="BlankBox" Content="Drop blank pages" Margin="0,0,16,4"
                                  IsChecked="True"
                                  Checked="BlankBox_Changed" Unchecked="BlankBox_Changed"/>
                        <CheckBox x:Name="DeskewBox" Content="Auto-straighten" Margin="0,0,16,4"
                                  IsChecked="True"
                                  Checked="DeskewBox_Changed" Unchecked="DeskewBox_Changed"/>
                        <CheckBox x:Name="TrimBox" Content="Trim margins" Margin="0,0,16,4"
                                  IsChecked="True"
                                  Checked="TrimBox_Changed" Unchecked="TrimBox_Changed"/>
                        <CheckBox x:Name="OcrBox" Content="Searchable PDF (OCR)"
                                  IsEnabled="False" Margin="0,0,0,4"
                                  ToolTip="OCR is not bundled. See IScanOcr."/>
                    </WrapPanel>

                    <StackPanel x:Name="InsertRow" Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock Text="Add to open PDF" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="InsertBox" Width="180" Height="28"
                                  SelectionChanged="InsertBox_SelectionChanged"/>
                    </StackPanel>

                    <DockPanel Margin="0,10,0,0">
                        <ProgressBar x:Name="ScanProgressBar" DockPanel.Dock="Right"
                                     Width="140" Height="6" Margin="12,0,0,0"
                                     IsIndeterminate="True" Visibility="Collapsed"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Choose a scanner and click Scan."/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,12,4">
                        <TextBlock Text="Pages" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PageCountText" DockPanel.Dock="Right"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="8" VerticalAlignment="Top">
                        <Button Content="Up" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="MoveUp_Click" Margin="0,0,0,6" ToolTip="Move up (Ctrl+Up)"/>
                        <Button Content="Down" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="MoveDown_Click" Margin="0,0,0,6" ToolTip="Move down (Ctrl+Down)"/>
                        <Button Content="Rotate" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="Rotate_Click" Margin="0,0,0,6" ToolTip="Rotate 90° (R)"/>
                        <Button Content="Rescan" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="Rescan_Click" Margin="0,0,0,6" ToolTip="Replace this page"/>
                        <Button Content="Trim" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="Trim_Click" Margin="0,0,0,6" ToolTip="Trim margins (T)"/>
                        <Button Content="Crop" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="Crop_Click" Margin="0,0,0,6" ToolTip="Crop this page"/>
                        <Button Content="Delete" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="Delete_Click" ToolTip="Remove page (Del)"/>
                    </StackPanel>
                    <ListBox x:Name="ThumbList"
                             Background="{StaticResource CanvasBrush}"
                             BorderThickness="0"
                             Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="ThumbList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ThumbList_PreviewMouseMove"
                             Drop="ThumbList_Drop"
                             DragOver="ThumbList_DragOver"
                             SelectionChanged="ThumbList_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="White" BorderThickness="2"
                                                    BorderBrush="Transparent" CornerRadius="3" Padding="4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="92">
                                    <Image Source="{Binding Preview}" Height="110" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
