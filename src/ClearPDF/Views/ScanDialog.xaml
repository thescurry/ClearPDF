<Window x:Class="ClearPDF.Views.ScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan to PDF"
        Height="560" Width="820"
        MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource CanvasBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderMutedBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AppendButton" Content="Append to open PDF"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="Append_Click"/>
                    <Button x:Name="SaveNewButton" Content="Save as new PDF"
                            Style="{StaticResource PrimaryButton}"
                            Click="SaveNew_Click"/>
                </StackPanel>
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" IsCancel="True" Click="Close_Click"/>
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Scanner" VerticalAlignment="Center" Margin="0,0,12,8"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ComboBox x:Name="ScannerBox" Grid.Column="1" Margin="0,0,0,8" Height="28"
                              DisplayMemberPath="Name" SelectionChanged="Settings_Changed"/>

                    <TextBlock Grid.Row="1" Text="Source" VerticalAlignment="Center" Margin="0,0,12,8"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="SourceBox" Width="140" Height="28" Margin="0,0,16,0"
                                  SelectionChanged="Settings_Changed"/>
                        <TextBlock Text="Color" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ColorBox" Width="140" Height="28" Margin="0,0,16,0"/>
                        <TextBlock Text="DPI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="DpiBox" Width="80" Height="28"/>
                        <CheckBox x:Name="DuplexBox" Content="Duplex" VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="ScanButton" Content="Scan" Style="{StaticResource PrimaryButton}"
                                Click="Scan_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ScanMoreButton" Content="Scan more" Style="{StaticResource SecondaryButton}"
                                Click="Scan_Click" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button x:Name="CancelScanButton" Content="Stop" Style="{StaticResource SecondaryButton}"
                                Click="CancelScan_Click" IsEnabled="False"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Choose a scanner and click Scan."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pages"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="12,10,12,4"/>
                    <StackPanel DockPanel.Dock="Right" Margin="8" VerticalAlignment="Top">
                        <Button Content="Up" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="MoveUp_Click" Margin="0,0,0,6" ToolTip="Move selected page up"/>
                        <Button Content="Down" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="MoveDown_Click" Margin="0,0,0,6" ToolTip="Move selected page down"/>
                        <Button Content="Rotate" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="Rotate_Click" Margin="0,0,0,6" ToolTip="Rotate selected page 90°"/>
                        <Button Content="Delete" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                Click="Delete_Click" ToolTip="Remove selected page"/>
                    </StackPanel>
                    <ListBox x:Name="ThumbList"
                             Background="{StaticResource CanvasBrush}"
                             BorderThickness="0"
                             Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="ThumbList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ThumbList_PreviewMouseMove"
                             Drop="ThumbList_Drop"
                             DragOver="ThumbList_DragOver"
                             SelectionChanged="ThumbList_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="White" BorderThickness="2"
                                                    BorderBrush="Transparent" CornerRadius="3" Padding="4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="92">
                                    <Image Source="{Binding Preview}" Height="110" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
