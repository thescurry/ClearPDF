<Window x:Class="ClearPDF.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        MinWidth="380">
    <!-- Matches docs/mocks/03-password.png: centered card, accent Unlock, never stores password -->
    <Border Background="White" CornerRadius="6" Padding="28,24"
            BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <StackPanel Width="320">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="28" Height="28" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" Margin="0,-1,0,0"/>
                </Border>
                <TextBlock Text="Password required"
                           FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"
                           Foreground="#222222" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="This PDF is encrypted. Enter the password to view."
                       FontFamily="Segoe UI" FontSize="12.5"
                       Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Border Height="1" Background="#E8E8E8" Margin="0,0,0,16"/>

            <PasswordBox x:Name="PasswordBox"
                         Height="34"
                         FontSize="14"
                         Padding="8,6"
                         BorderBrush="#C8C8C8"
                         BorderThickness="1"
                         KeyDown="PasswordBox_KeyDown"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="#B00020"
                       FontSize="12"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Unlock" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Unlock_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
