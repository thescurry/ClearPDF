<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClearPDF.Mac.Views.PasswordDialog"
        Title="Password required"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Background="Transparent">
    <Border Background="White" CornerRadius="6" Padding="28,24"
            BorderBrush="#E0E0E0" BorderThickness="1" Margin="8">
        <StackPanel Width="320">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="28" Height="28" CornerRadius="4" Background="#5A7FA6" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White"/>
                </Border>
                <TextBlock Text="Password required"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="#222222" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="This PDF is encrypted. Enter the password to view."
                       FontSize="13" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Border Height="1" Background="#E8E8E8" Margin="0,0,0,16"/>
            <TextBox x:Name="PasswordBox" Height="34" FontSize="14" Padding="8,6"
                     PasswordChar="•" KeyDown="PasswordBox_KeyDown"/>
            <TextBlock x:Name="ErrorText" Foreground="#B00020" FontSize="12"
                       Margin="0,8,0,0" IsVisible="False" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="8">
                <Button Content="Cancel" Classes="secondary" Click="Cancel_Click"/>
                <Button Content="Unlock" Classes="primary" Click="Unlock_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
